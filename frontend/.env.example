# PostgreSQL connection string (same DB the Express backend uses).
# Neon (pooled): postgresql://user:pass@ep-xxx-pooler.c-...neon.tech/neondb?sslmode=require
# Local:         postgresql://postgres@localhost:5432/assign_db?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/assign_db?schema=public"

# Must match AUTH_SECRET in backend/.env (Auth.js encrypts its session JWT with it)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of the Express API
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional: force the base URL for this Next.js app.
# Leave unset in development so Auth.js infers the port automatically
# (it picks whatever port `next dev` runs on). Set it in production.
# AUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth — create at https://github.com/settings/developers
# Authorization callback URL: <your-origin>/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

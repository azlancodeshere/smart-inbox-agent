# PostgreSQL connection string.
# Neon (pooled): postgresql://user:pass@ep-xxx-pooler.c-...neon.tech/neondb?sslmode=require
# Local:         postgresql://postgres@localhost:5432/assign_db?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/assign_db?schema=public"

# Must match AUTH_SECRET in frontend/.env (Auth.js signs its session JWT with it)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Port the Express API listens on
PORT=4000

# Allowed origin for CORS (the Next.js frontend)
CLIENT_ORIGIN="http://localhost:3000"

# --- Access / refresh token pair (JWT) ---
ACCESS_TOKEN_SECRET=generate-with-openssl-rand-base64-48
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=generate-with-openssl-rand-base64-48
REFRESH_TOKEN_EXPIRY=7d
